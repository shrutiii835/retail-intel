        "toTable": "dim_campaign",
        "toColumn": "campaign_key"
      },
      {
        "name": "rel_fact_inventory_snapshot_date_key_dim_date",
        "fromTable": "fact_inventory_snapshot",
        "fromColumn": "date_key",
        "toTable": "dim_date",
        "toColumn": "date_key"
      },
      {
        "name": "rel_fact_inventory_snapshot_product_key_dim_product",
        "fromTable": "fact_inventory_snapshot",
        "fromColumn": "product_key",
        "toTable": "dim_product",
        "toColumn": "product_key"
      },
      {
        "name": "rel_fact_inventory_snapshot_store_key_dim_store",
        "fromTable": "fact_inventory_snapshot",
        "fromColumn": "store_key",
        "toTable": "dim_store",
        "toColumn": "store_key"
      },
      {
        "name": "rel_mart_campaign_roi_campaign_key_dim_campaign",
        "fromTable": "mart_campaign_roi",
        "fromColumn": "campaign_key",
        "toTable": "dim_campaign",
