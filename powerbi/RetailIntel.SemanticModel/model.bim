      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"dim_date\", \"dim_product\", \"dim_store\", \"dim_campaign\", \"fact_sales\", \"fact_inventory_snapshot\", \"mart_campaign_roi\", \"_Measures\"]"
      }
    ]
  }
}