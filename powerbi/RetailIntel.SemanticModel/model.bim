      {
        "name": "_Measures",
        "columns": [
          {
            "name": "_placeholder",
            "dataType": "string",
            "sourceColumn": "_placeholder",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Measures-partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table({\"_placeholder\"}, {{\"\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM ( fact_sales[net_revenue] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Units Sold",
            "expression": "SUM ( fact_sales[quantity] )",
            "formatString": "#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Transactions",
            "expression": "DISTINCTCOUNT ( fact_sales[transaction_id] )",
            "formatString": "#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Total COGS",
            "expression": "SUM ( fact_sales[cogs] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Gross Profit",
            "expression": "SUM ( fact_sales[gross_profit] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Gross Margin %",
            "expression": "DIVIDE ( [Gross Profit], [Total Revenue] )",
            "formatString": "0.0%",
            "displayFolder": "Sales"
          },
          {
            "name": "Gross Sales",
            "expression": "SUM ( fact_sales[gross_amount] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Total Discount",
            "expression": "SUM ( fact_sales[discount_amount] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Discount Rate %",
            "expression": "DIVIDE ( [Total Discount], [Gross Sales] )",
            "formatString": "0.0%",
            "displayFolder": "Sales"
          },
          {
            "name": "Average Basket Value",
            "expression": "DIVIDE ( [Total Revenue], [Transactions] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Units per Transaction",
            "expression": "DIVIDE ( [Units Sold], [Transactions] )",
            "formatString": "0.00",
            "displayFolder": "Sales"
          },
          {
            "name": "Promoted Revenue",
            "expression": "CALCULATE ( [Total Revenue], fact_sales[is_promoted] = TRUE () )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Promotion"
          },
          {
            "name": "Non-Promoted Revenue",
            "expression": "CALCULATE ( [Total Revenue], fact_sales[is_promoted] = FALSE () )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Promotion"
          },
          {
            "name": "Promoted Revenue %",
            "expression": "DIVIDE ( [Promoted Revenue], [Total Revenue] )",
            "formatString": "0.0%",
            "displayFolder": "Promotion"
          },
          {
            "name": "Promoted Units",
            "expression": "CALCULATE ( [Units Sold], fact_sales[is_promoted] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Promotion"
          },
          {
            "name": "Campaign Cost",
            "expression": "SUM ( mart_campaign_roi[campaign_cost] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Campaign Revenue",
            "expression": "SUM ( mart_campaign_roi[campaign_revenue] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Incremental Revenue",
            "expression": "SUM ( mart_campaign_roi[incremental_revenue] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Incremental Units",
            "expression": "SUM ( mart_campaign_roi[incremental_units] )",
            "formatString": "#,0",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Incremental Gross Profit",
            "expression": "SUM ( mart_campaign_roi[incremental_gross_profit] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Portfolio ROI",
            "expression": "DIVIDE ( [Incremental Revenue] - [Campaign Cost], [Campaign Cost] )",
            "formatString": "0.00",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Portfolio ROI (Margin)",
            "expression": "DIVIDE ( [Incremental Gross Profit] - [Campaign Cost], [Campaign Cost] )",
            "formatString": "0.00",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Average Campaign ROI",
            "expression": "AVERAGE ( mart_campaign_roi[roi] )",
            "formatString": "0.00",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Campaign Count",
            "expression": "COUNTROWS ( mart_campaign_roi )",
            "formatString": "#,0",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Profitable Campaigns",
            "expression": "COUNTROWS ( FILTER ( mart_campaign_roi, mart_campaign_roi[roi] > 0 ) )",
            "formatString": "#,0",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Profitable Campaign %",
            "expression": "DIVIDE ( [Profitable Campaigns], [Campaign Count] )",
            "formatString": "0.0%",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Campaign Uplift %",
            "expression": "DIVIDE ( [Incremental Revenue], SUM ( mart_campaign_roi[expected_baseline_revenue] ) )",
            "formatString": "0.0%",
            "displayFolder": "Campaign ROI"
          },
          {
            "name": "Avg Inventory Units",
            "expression": [
              "AVERAGEX (",
              "    VALUES ( fact_inventory_snapshot[snapshot_date] ),",
              "    CALCULATE ( SUM ( fact_inventory_snapshot[stock_quantity] ) )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Inventory"
          },
          {
            "name": "Avg Inventory Value",
            "expression": [
              "AVERAGEX (",
              "    VALUES ( fact_inventory_snapshot[snapshot_date] ),",
              "    CALCULATE ( SUM ( fact_inventory_snapshot[stock_value_at_cost] ) )",
              ")"
            ],
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Inventory"
          },
          {
            "name": "Closing Stock Units",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_inventory_snapshot[stock_quantity] ),",
              "    LASTNONBLANK ( fact_inventory_snapshot[snapshot_date], 1 )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Inventory"
          },
          {
            "name": "Inventory Turnover",
            "expression": "DIVIDE ( [Total COGS], [Avg Inventory Value] )",
            "formatString": "0.00",
            "displayFolder": "Inventory"
          },
          {
            "name": "Days of Supply",
            "expression": [
              "VAR DaysInContext = COUNTROWS ( VALUES ( dim_date[date] ) )",
              "RETURN",
              "    DIVIDE ( DaysInContext, [Inventory Turnover] )"
            ],
            "formatString": "0.00",
            "displayFolder": "Inventory"
          },
          {
            "name": "Revenue Prior Month",
            "expression": "CALCULATE ( [Total Revenue], DATEADD ( dim_date[date], -1, MONTH ) )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Time"
          },
          {
            "name": "Revenue MoM %",
            "expression": "DIVIDE ( [Total Revenue] - [Revenue Prior Month], [Revenue Prior Month] )",
            "formatString": "0.0%",
            "displayFolder": "Time"
          },
          {
            "name": "Revenue YTD",
            "expression": "TOTALYTD ( [Total Revenue], dim_date[date] )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Time"
          },
          {
            "name": "Store Rank by Revenue",
            "expression": "RANKX ( ALLSELECTED ( dim_store[store_name] ), [Total Revenue],, DESC, DENSE )",
            "formatString": "#,0",
            "displayFolder": "Store"
          },
          {
            "name": "Revenue per Store",
            "expression": "DIVIDE ( [Total Revenue], DISTINCTCOUNT ( dim_store[store_key] ) )",
            "formatString": "\\\u20b9#,0;(\\\u20b9#,0);\\\u20b9#,0",
            "displayFolder": "Store"
          },
          {
            "name": "Revenue % of Total",
            "expression": "DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALLSELECTED ( dim_store ) ) )",
            "formatString": "0.0%",
            "displayFolder": "Store"
          },
          {
            "name": "Unattributed Campaign Rows",
            "expression": "CALCULATE ( COUNTROWS ( fact_sales ), fact_sales[campaign_resolved] = FALSE () )",
            "formatString": "#,0",
            "displayFolder": "Data Quality"
          },
          {
            "name": "Campaign Attribution %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( fact_sales ), fact_sales[campaign_resolved] = TRUE () ),",
              "    COUNTROWS ( fact_sales )",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "Data Quality"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_fact_sales_date_key_dim_date",
        "fromTable": "fact_sales",
        "fromColumn": "date_key",
        "toTable": "dim_date",
        "toColumn": "date_key"
      },
      {
        "name": "rel_fact_sales_product_key_dim_product",
