{
  "name": "ds_landing_csv",
  "properties": {
    "description": "Source-side landing CSV. Parameterised on batch and source name so one dataset definition serves all five feeds across all batches, instead of 15 near-identical datasets.",
    "linkedServiceName": {
      "referenceName": "ls_adls_gen2",
      "type": "LinkedServiceReference",
      "parameters": {
        "storage_account": {
          "value": "@dataset().storage_account",
          "type": "Expression"
        }
      }
    },
    "parameters": {
      "batch_id": { "type": "string" },
      "source_name": { "type": "string" },
      "storage_account": {
        "type": "string",
        "defaultValue": "stretailintel"
      }
    },
    "annotations": ["RetailIntel"],
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "landing",
        "folderPath": {
          "value": "@concat(dataset().batch_id, '/', dataset().source_name)",
          "type": "Expression"
        }
      },
      "columnDelimiter": ",",
      "escapeChar": "\\",
      "firstRowAsHeader": true,
      "quoteChar": "\""
    },
    "schema": []
  }
}
